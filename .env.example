# ---------------------------------------------------------------------------
# Front-end (Vite). Vao para o bundle publicado; podem ser publicas.
# No Netlify, cadastrar as duas em Site settings > Environment variables.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Scripts do administrador (scripts/*.ts). Somente no .env local do dono do
# projeto. NUNCA comitar e NUNCA expor no navegador.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# E-mail do administrador inicial criado por scripts/criar-admin.ts.
# A senha e digitada no terminal, nao fica em arquivo.
ADMIN_EMAIL=joaogaletti@gmail.com
ADMIN_NOME_EXIBICAO=Joao Galetti

# Contato publicado no User-Agent das chamadas a Overpass API (exigencia de uso).
OSM_CONTATO=joaogaletti@gmail.com

# ---------------------------------------------------------------------------
# Edge Function admin-usuarios: definir como segredo, nao como variavel do site
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY ja sao injetados pela plataforma.
# ---------------------------------------------------------------------------
